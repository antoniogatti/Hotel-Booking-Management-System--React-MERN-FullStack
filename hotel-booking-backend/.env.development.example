# Backend development profile (local)
NODE_ENV=development
PORT=5000

# Database
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/hotel-booking

# Security
JWT_SECRET_KEY=replace_with_long_random_secret

# CORS
FRONTEND_URL=http://localhost:5174
# Optional comma-separated list for additional local origins
FRONTEND_URLS=http://localhost:5174,http://localhost:5173

# Public backend URL for OAuth callback generation in local tests
BACKEND_URL=http://localhost:5000

# Cloudflare Turnstile (captcha)
TURNSTILE_SECRET=replace_with_turnstile_secret
ENABLE_DEV_CAPTCHA=false

# Self check-in settings
SELF_CHECKIN_RATE_LIMIT=20
SELF_CHECKIN_INSTRUCTION_VIDEO_URL=https://www.youtube.com/watch?v=PRb5yw89zxw

# Application Insights (telemetry + traces)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=770defd0-fe16-4fca-af55-465364661c2a;IngestionEndpoint=https://italynorth-0.in.applicationinsights.azure.com/;LiveEndpoint=https://italynorth.livediagnostics.monitor.azure.com/;ApplicationId=ef6f5b07-0ecb-478d-a546-3527f949a6a8

# Microsoft Entra OAuth
MS_ENTRA_CLIENT_ID=replace_with_client_id
MS_ENTRA_CLIENT_SECRET=replace_with_client_secret
MS_ENTRA_TENANT_ID=common

# Contact form mail delivery (Microsoft Graph sendMail)
CONTACT_MAIL_SENDER=info@palazzopintobnb.com
CONTACT_MAIL_INBOX=info@palazzopintobnb.com
CONTACT_MAIL_SUBJECT_PREFIX=Palazzo Pinto B&B 
CONTACT_MAIL_CONFIRMATION_SUBJECT=Message Sent - Confirmation

# Azure OpenAI booking extraction
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace_with_azure_openai_key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Payments
STRIPE_API_KEY=sk_test_replace_me

APPINSIGHTS_INSTRUMENTATIONKEY=770defd0-fe16-4fca-af55-465364661c2a

